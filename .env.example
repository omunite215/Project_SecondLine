# Local secrets for infra/compose. `make bootstrap` copies this to .env (gitignored, mode 600) and fills every
# empty value with a random secret. Never commit .env; never put a real value here.
POSTGRES_DB=secondline
POSTGRES_PASSWORD=
LEDGER_SVC_PASSWORD=
LEDGER_MIGRATOR_PASSWORD=
GRADER_SVC_PASSWORD=
OPERATOR_SVC_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
