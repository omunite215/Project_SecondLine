{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondline.invalid/contracts/1/tools/read_reference_data.output.schema.json",
  "title": "Read-only security or SSI record \u2014 output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "record_type",
    "attributes",
    "record_version"
  ],
  "properties": {
    "record_id": {
      "$ref": "../common.schema.json#/$defs/opaque_id"
    },
    "record_type": {
      "enum": [
        "SECURITY",
        "SSI",
        "COUNTERPARTY"
      ]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 200
      },
      "maxProperties": 40
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
