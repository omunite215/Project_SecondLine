{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondline.invalid/contracts/1/events/envelope.schema.json",
  "title": "Event envelope (§12)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "run_id",
    "scenario_id",
    "actor_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "committed_at",
    "aggregate_id",
    "aggregate_version",
    "correlation_id",
    "payload_hash",
    "evidence_hashes",
    "redaction_class"
  ],
  "properties": {
    "event_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "run_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "scenario_id": {
      "$ref": "../common.schema.json#/$defs/scenario_ref"
    },
    "break_id": {
      "$ref": "../common.schema.json#/$defs/opaque_id"
    },
    "actor_id": {
      "$ref": "../common.schema.json#/$defs/opaque_id"
    },
    "action_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z_]+)+$"
    },
    "schema_version": {
      "const": "1.0"
    },
    "occurred_at": {
      "$ref": "../common.schema.json#/$defs/utc_timestamp"
    },
    "committed_at": {
      "$ref": "../common.schema.json#/$defs/utc_timestamp"
    },
    "aggregate_id": {
      "type": "string",
      "maxLength": 64
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 0
    },
    "correlation_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "causation_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "policy_decision_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "payload_hash": {
      "$ref": "../common.schema.json#/$defs/sha256_ref"
    },
    "evidence_hashes": {
      "type": "array",
      "items": {
        "$ref": "../common.schema.json#/$defs/sha256_ref"
      }
    },
    "transaction_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "redaction_class": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED"
      ]
    }
  },
  "description": "transaction_id is the ledger transaction (receipts call it ledger_transaction_id, C5)."
}
