{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondline.invalid/contracts/1/scenario/ns_export.schema.json",
  "title": "NamespaceExport",
  "description": "Canonical ns state export; state hash = sha256(JCS(this)) (ADR-015, T-EVAL-03). Arrays sorted by account, then currency/isin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["export_version", "ns", "snapshot_hash", "state_version", "cash_balances", "security_balances"],
  "properties": {
    "export_version": {"const": "1.0"},
    "ns": {"$ref": "../common.schema.json#/$defs/uuid"},
    "snapshot_hash": {"$ref": "../common.schema.json#/$defs/sha256_ref"},
    "state_version": {"$ref": "../common.schema.json#/$defs/state_version"},
    "cash_balances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account", "currency", "balance"],
        "properties": {
          "account": {"$ref": "../common.schema.json#/$defs/cash_account"},
          "currency": {"$ref": "../common.schema.json#/$defs/currency"},
          "balance": {"$ref": "../common.schema.json#/$defs/decimal", "description": "Signed, debit positive."}
        }
      }
    },
    "security_balances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account", "isin", "quantity"],
        "properties": {
          "account": {"$ref": "../common.schema.json#/$defs/security_account"},
          "isin": {"$ref": "../common.schema.json#/$defs/isin"},
          "quantity": {"$ref": "../common.schema.json#/$defs/quantity"}
        }
      }
    }
  }
}
