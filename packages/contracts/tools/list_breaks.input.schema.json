{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondline.invalid/contracts/1/tools/list_breaks.input.schema.json",
  "title": "List the run's breaks \u2014 input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id"
  ],
  "properties": {
    "run_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "status": {
