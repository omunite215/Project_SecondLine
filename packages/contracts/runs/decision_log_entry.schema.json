{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondline.invalid/contracts/2/runs/decision_log_entry.schema.json",
  "title": "Gateway decision log entry",
  "description": "One per tool call, denies included (\u00a78 step 3, ADR-013). stage = where the call was decided; ALLOW at stage routed means the ledger answered. Stored append-only by the ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "run_id",
    "tool",
    "decision",
    "controls",
    "stage",
    "at"
  ],
  "properties": {
    "decision_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "run_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "tool": {
      "$ref": "../common.schema.json#/$defs/tool_name"
    },
    "action_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "REVIEW_REQUIRED"
      ]
    },
    "error_code": {
      "$ref": "../error_response.schema.json#/properties/error_code"
    },
    "controls": {
      "$ref": "run_request.schema.json#/properties/controls"
    },
    "policy_bundle_hash": {
      "$ref": "../common.schema.json#/$defs/sha256_ref"
    },
    "stage": {
      "enum": [
        "token",
        "binding",
        "schema",
        "guard",
        "policy",
        "ledger",
        "routed"
      ]
    },
    "at": {
      "$ref": "../common.schema.json#/$defs/utc_timestamp"
    }
  }
}
