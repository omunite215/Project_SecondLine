{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make kit-check)",
      "Bash(make board-*)",
      "Bash(make trace)",
      "Bash(make skills-check)",
      "Bash(make skills-list)",
      "Bash(make contracts-check)",
      "Bash(make codegen)",
      "Bash(make test-*)",
      "Bash(make leakage-check)",
      "Bash(make logs *)",
      "Bash(make up *)",
      "Bash(make down)",
      "Bash(python3 scripts/board.py *)",
      "Bash(python3 scripts/skills.py check *)",
      "Bash(python3 scripts/skills.py list *)",
      "Bash(python3 scripts/skills.py lint *)",
      "Bash(python3 scripts/skills.py gate *)",
      "Bash(python3 scripts/ctx.py *)",
      "Bash(python3 scripts/ctx_budget.py *)",
      "Bash(python3 scripts/split_spec.py *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(uv sync *)",
      "Bash(./gradlew *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose config *)",
      "Bash(opa test *)",
      "Bash(opa fmt *)",
      "Bash(rg *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
      "Bash(gh auth status *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.ed25519)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(/data/generated/eval/**)",
      "Read(/data/generated/blind/**)",
      "Edit(/docs/spec/MASTER_SPEC.md)",
      "Edit(/docs/spec/sections/**)",
      "Edit(/experiments/prereg/frozen/**)",
      "Edit(/.claude/.skills-ok.json)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(gh auth token *)",
      "Bash(gh secret *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr edit *)",
      "Bash(claude plugin *)",
      "Bash(make skills-install *)",
      "Bash(python3 scripts/skills.py install *)",
      "Bash(make skills-update *)",
      "Bash(make hpc-up *)",
      "Bash(make hpc-down *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(docker compose down -v *)",
      "Bash(rm -rf *)",
      "Read(/experiments/runs/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/tooling/claude-skills.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/tooling/skills.lock.json)",
      "Edit(/scripts/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/board.py\" brief",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/skills.py\" gate --session",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_edit.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/skills.py\" gate --edit",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/skills.py\" gate --bash",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/fmt.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  }
}
