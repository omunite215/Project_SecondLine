{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondline.invalid/contracts/2/tools/read_custodian_statement.output.schema.json",
  "title": "Synthetic custodian statement \u2014 output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "as_of_date",
    "lines"
  ],
  "properties": {
    "as_of_date": {
      "$ref": "../common.schema.json#/$defs/date"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "record_version",
          "isin",
          "quantity"
        ],
        "properties": {
          "record_id": {
            "$ref": "../common.schema.json#/$defs/opaque_id"
          },
          "record_version": {
            "type": "integer",
            "minimum": 1
          },
          "isin": {
            "$ref": "../common.schema.json#/$defs/isin"
          },
          "quantity": {
            "$ref": "../common.schema.json#/$defs/quantity"
          }
        }
      }
    }
  },
  "description": "Latest CUSTODIAN_STATEMENT records as of a date; each line is one citable record (OM-04)."
}
